{
  "name": "sana-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:pages": "tsc --noEmit && vite build --base=/SanaWebsite/",
    "test:pages": "npm run build:pages && node tests/pages-smoke.mjs",
    "publish:pages": "npm run build:pages && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
